# Copy this file to .env and fill in your local values.
# The password is intentionally NOT read from this file -- export it as the
# PGPASSWORD environment variable instead (same convention ord_schema's own
# scripts/add_datasets.py uses), so it never ends up written to disk here.

ORD_DB_HOST=localhost
ORD_DB_PORT=5432
ORD_DB_NAME=ord
ORD_DB_USER=postgres
